# Copia este archivo a .env. Escribe las claves únicamente en la copia local.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-5.4-mini
MT5_SYMBOLS=EURUSDmicro,USDJPYmicro,XAUUSDmicro

# Descomenta y completa solo para la ejecución demo.
# MT5_DEMO_LOGIN=
# MT5_EXECUTION_CONFIG=data/demo_execution.json
# MT5_NEWS_CALENDAR=data/news_calendar.json

# Telegram es opcional. Inicia el chat con tu bot y agrega sus datos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Si cambias de modelo, puedes configurar sus tarifas estándar en USD por millón.
# GEMINI_INPUT_USD_PER_MTOK=
# GEMINI_OUTPUT_USD_PER_MTOK=
# OPENAI_INPUT_USD_PER_MTOK=
# OPENAI_OUTPUT_USD_PER_MTOK=

# Usa este valor en el backend y el motor si eliges otro archivo de diario.
# PROSPECTIVE_DB=data/prospective_v22.sqlite3

# Terminal de Windows ya autenticado manualmente en la cuenta Deriv demo.
# Si existe el terminal en AppData, se selecciona automáticamente.
# MT5_TERMINAL_PATH=${APPDATA}/MetaTrader 5/terminal64.exe
# MT5_TIMEOUT_MS=4000
# MT5_EXPECTED_SERVER=
OPENAI_ENABLED=0
# El token local protege los controles autenticados de FastAPI.
LAB_CONTROL_TOKEN=
# Si se configura, el supervisor actualiza un calendario candidato por separado.
FINNHUB_API_KEY=
# Activalo solo tras autorizar envíos a tu chat.
TELEGRAM_ENABLED=0
# Los scripts de pruebas históricas requieren consentimiento local de gasto.
LAB_LEGACY_API_COST=0
